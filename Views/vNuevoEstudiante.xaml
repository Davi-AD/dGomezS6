<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dGomezS6.Views.vNuevoEstudiante"
             Title="vNuevoEstudiante">
    <VerticalStackLayout
       Spacing="20"
       Padding="20">
        <Label 
           Text="Agregar nuevo estudiante"
           VerticalOptions="Center" 
           HorizontalOptions="Center" />
        
        <Grid RowSpacing="20" ColumnSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Label Text="NOMBRE DEL ESTUDIANTE"
                  Grid.Row="0"
                  Grid.Column="0"></Label>
            <Entry x:Name="txtNombre"
                  Placeholder="Ingresar el nombre"
                  Grid.Row="0"
                  Grid.Column="1"></Entry>
            <Label Text="APELLIDO DEL ESTUDIANTE"
                  Grid.Row="1"
                  Grid.Column="0"></Label>
            <Entry x:Name="txtApellido"
                  Placeholder="Ingresar el Apellido"
                  Grid.Row="1"
                  Grid.Column="1"></Entry>
            <Label Text="EDAD DEL ESTUDIANTE"
                  Grid.Row="2"
                  Grid.Column="0"></Label>
            <Entry x:Name="txtEdad"
                  Placeholder="Ingrese edad"
                  Grid.Row="2"
                  Grid.Column="1"
                  Keyboard="Numeric"
                  MaxLength="2"></Entry>
        </Grid>
        <Button
           x:Name="btnAgregar"
           Text="Agrega un estudiante"
           Clicked="btnAgregar_Clicked"></Button>
        
   

    </VerticalStackLayout>

</ContentPage>